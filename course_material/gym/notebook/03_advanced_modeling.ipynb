{"nbformat":4,"nbformat_minor":5,"metadata":{"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"language_info":{"name":"python","version":"3.12"},"ground_truth_ml":{"edition":"propensity-4.0","execution_order":["01_data_readiness_and_eda","02_basic_modeling","03_advanced_modeling","04_member_scoring_and_business_decision"],"requires_prior_outputs":false,"student_package":{"course_id":"ground-truth-gym-l3-4.0","setup_cell_added":true,"original_lesson_code_unchanged":true}}},"cells":[{"cell_type":"markdown","id":"course-start-guide","metadata":{},"source":["## Start here — Google Colab\n\nOpen this notebook from the course website or GitHub. On first use, the setup cell connects Google Drive and places the public course folder there if it is not already present. It expands the prepared synthetic inputs and installs the pinned libraries automatically.\n\nStart with **01** and run each notebook in order: **01 → 02 → 03 → 04**. Keep the course folder together and use the same Colab runtime for the sequence. CPU is sufficient. The data-generation notebook is not part of this learner path."]},{"cell_type":"code","id":"course-auto-setup","metadata":{"tags":["course-setup"]},"source":["# Connect Drive and prepare this course automatically before importing lesson libraries.\n","from pathlib import Path\n","import gzip\n","import os\n","import shutil\n","import sys\n","import json\n","import subprocess\n","import importlib.metadata as package_metadata\n","\n","COURSE_ID = 'ground-truth-gym-l3-4.0'\n","MARKER = 'COURSE_PACKAGE.json'\n","REPOSITORY_URL = 'https://github.com/GroundTruthML/Course_Material.git'\n","REPOSITORY_FOLDER = 'GroundTruth_Course_Material'\n","try:\n","    from google.colab import drive\n","except ImportError:\n","    drive = None\n","\n","if drive is not None:\n","    drive.mount('/content/drive')\n","    search_root = Path('/content/drive/MyDrive')\n","else:\n","    search_root = Path.cwd()\n","\n","\n","def is_course_folder(path):\n","    marker = path / MARKER\n","    return marker.is_file() and json.loads(marker.read_text()).get('course_id') == COURSE_ID\n","\n","\n","def find_local_course():\n","    for candidate in [Path.cwd(), *Path.cwd().parents]:\n","        if is_course_folder(candidate):\n","            return candidate\n","    return None\n","\n","\n","def find_drive_course(root):\n","    matches = []\n","    for directory, subfolders, files in os.walk(root):\n","        subfolders[:] = [name for name in subfolders if not name.startswith('.') and name not in {'node_modules', '__pycache__', '.git'}]\n","        if MARKER in files:\n","            candidate = Path(directory)\n","            if is_course_folder(candidate):\n","                matches.append(candidate)\n","                subfolders[:] = []\n","    canonical = root / REPOSITORY_FOLDER / 'course_material' / 'gym'\n","    if is_course_folder(canonical):\n","        return canonical\n","    if len(matches) == 1:\n","        return matches[0]\n","    if len(matches) > 1:\n","        raise RuntimeError('More than one Gym course folder was found in My Drive. Keep one copy, then rerun this cell.')\n","    return None\n","\n","\n","course_root = find_drive_course(search_root) if drive is not None else find_local_course()\n","if course_root is None and drive is not None:\n","    repository_root = search_root / REPOSITORY_FOLDER\n","    if repository_root.exists():\n","        raise RuntimeError('The course repository folder exists but is incomplete. Remove that incomplete copy from My Drive and rerun this cell.')\n","    subprocess.check_call(['git', 'clone', '--depth', '1', REPOSITORY_URL, str(repository_root)])\n","    course_root = repository_root / 'course_material' / 'gym'\n","if course_root is None or not is_course_folder(course_root):\n","    raise RuntimeError('Open this notebook from the public Course_Material repository, or keep the complete course_material/gym folder together.')\n","os.chdir(course_root)\n","\n","# Expand only the prepared synthetic input files. Notebook outputs are written separately.\n","DATA_DIR = course_root / 'gym_case_data'\n","INPUT_DIR = course_root / 'input_data' / 'gym_case_data'\n","if not (DATA_DIR / 'manifest.json').exists():\n","    shutil.copy2(INPUT_DIR / 'manifest.json', DATA_DIR / 'manifest.json')\n","manifest = json.loads((DATA_DIR / 'manifest.json').read_text())\n","(DATA_DIR / 'raw').mkdir(parents=True, exist_ok=True)\n","for table_name in manifest['tables']:\n","    csv_path = DATA_DIR / 'raw' / f'{table_name}.csv'\n","    if not csv_path.exists():\n","        compressed_path = INPUT_DIR / 'raw' / f'{table_name}.csv.gz'\n","        if not compressed_path.exists():\n","            raise FileNotFoundError(f'Missing prepared input: {compressed_path}')\n","        with gzip.open(compressed_path, 'rb') as source, csv_path.open('wb') as destination:\n","            shutil.copyfileobj(source, destination)\n","\n","requirements = (course_root / 'requirements-colab.txt').read_text().splitlines()\n","requirements = [line.strip() for line in requirements if line.strip() and not line.startswith('#')]\n","if drive is not None:\n","    dependency_dir = Path('/content/groundtruth_gym_dependencies')\n","    stamp = dependency_dir / 'course_requirements.json'\n","    if not stamp.exists() or json.loads(stamp.read_text()) != requirements:\n","        subprocess.check_call([sys.executable, '-m', 'pip', 'install', '--quiet', '--upgrade', '--target', str(dependency_dir), *requirements])\n","        stamp.write_text(json.dumps(requirements))\n","    sys.path.insert(0, str(dependency_dir))\n","    for distribution, module in [('numpy', 'numpy'), ('pandas', 'pandas'), ('scipy', 'scipy'), ('scikit-learn', 'sklearn'), ('matplotlib', 'matplotlib'), ('joblib', 'joblib')]:\n","        expected = next(line.split('==')[1] for line in requirements if line.startswith(distribution + '=='))\n","        loaded = sys.modules.get(module)\n","        if loaded is not None and getattr(loaded, '__version__', expected) != expected:\n","            raise RuntimeError('Please select Runtime > Disconnect and delete runtime, reconnect, and Run all. No path or package configuration is needed.')\n","\n","for item in requirements:\n","    distribution, expected = item.split('==')\n","    actual = package_metadata.version(distribution)\n","    if actual != expected:\n","        raise RuntimeError(f'{distribution}: expected {expected}, found {actual}. Use a fresh Colab runtime and run this first cell.')\n","\n","for variable in ['OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS']:\n","    os.environ[variable] = '1'\n","print('Course ready:', course_root)\n","print('Prepared synthetic inputs are ready. Run notebooks 01 → 02 → 03 → 04 in this order.')"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"section":""},"source":["# 03 — Compare feature representations and evaluate the selected pipeline\n","\n","**Purpose:** Test alternatives to02's full-feature baseline. Read the saved handoff; use training for development, February for comparison and April for later evaluation.\n","\n","| Representation | Inputs | Models |\n","|---|---:|---|\n","| Full |18 | Logistic + GBM |\n","| Reduced |8 from training-only importance | Logistic + GBM |\n","| Engineered |18 + 2 fixed activity summaries | Logistic + GBM |\n","\n","### Follow the comparison\n","**ADV-01** reload/check → **ADV-02** importance → **ADV-03** candidate representations → **ADV-04** validation/finalize → **ADV-05** April → **ADV-06** save.\n","\n","**Inputs:** member_features.csv, basic_model_bundle.joblib, manifest.json. **Outputs:** importance/representation reports, frozen model bundle, April reports and model card.\n","\n","**Reading pattern:** question → plan → annotated code → output → takeaway. Improvement is a question for the experiment, not a promised result."],"id":"03-000"},{"cell_type":"markdown","metadata":{"section":"ADV-01 — Reload the development contract and enforce chronology"},"source":["## ADV-01 — Reload the development contract and enforce chronology\n","\n","### The question\n","Which baseline and data roles must stay consistent during development?\n","\n","### The plan\n","- Reload02 models/configuration and the feature table.\n","- Restore chronological training/validation roles.\n","- Check identity, availability, label completeness and excluded predictors.\n","\n","### What to look for\n","Confirm350/76 training and150/37 validation support. Upcoming rows stay outside fitting and importance."],"id":"03-001"},{"cell_type":"code","metadata":{"section":"ADV-01 — Reload the development contract and enforce chronology"},"source":["# Import libraries for saved files, arrays, tables and inspection.\n","from pathlib import Path\n","import json, hashlib\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","from IPython.display import display\n","\n","\n","# Model utilities: fitting, preprocessing, internal diagnostics and ranking evaluation.\n","from sklearn.base import clone\n","\n","\n","from sklearn.compose import ColumnTransformer\n","\n","\n","from sklearn.pipeline import Pipeline\n","\n","\n","from sklearn.impute import SimpleImputer\n","\n","\n","from sklearn.preprocessing import StandardScaler, OneHotEncoder\n","\n","\n","from sklearn.linear_model import LogisticRegression\n","\n","\n","from sklearn.ensemble import GradientBoostingClassifier\n","\n","\n","from sklearn.model_selection import train_test_split\n","\n","\n","from sklearn.inspection import permutation_importance\n","\n","\n","from sklearn.metrics import average_precision_score, brier_score_loss\n","import sklearn, joblib\n","\n","\n","# Input/output paths: notebooks run from Current beside gym_case_data.\n","DATA_DIR = Path('gym_case_data'); MODEL_DIR = DATA_DIR / 'model'\n","\n","\n","# Check the preceding notebook artifact exists before continuing.\n","assert (MODEL_DIR / 'basic_model_bundle.joblib').exists(), 'Run notebook 02 first.'\n","\n","\n","# Record rules and file hashes so01 can verify the exact fixture.\n","manifest = json.loads((DATA_DIR / 'manifest.json').read_text())\n","\n","\n","# Reload the exact basic-model contract; trusted artifact files only.\n","basic = joblib.load(MODEL_DIR / 'basic_model_bundle.joblib')\n","assert basic['data_version'] == manifest['data_version'] and basic['sklearn_version'] == sklearn.__version__\n","\n","\n","# Reuse baseline settings so the experiment changes representations rather than many conditions.\n","config = basic['config']; SEED = config['seed']; CONTACT_FRACTION = config['contact_fraction']\n","FEATURE_COLUMNS = basic['feature_columns']; NUMERIC_FEATURES = basic['numeric_features']; CATEGORICAL_FEATURES = basic['categorical_features']\n","\n","\n","# Load member-level measurements; parse dates before temporal assertions.\n","features = pd.read_csv(DATA_DIR / 'member_features.csv')\n","for column in ['decision_time', 'signup_at', 'snapshot_available_at', 'label_ready_at', 'payments_complete_through']:\n","    features[column] = pd.to_datetime(features[column], utc=True, format='mixed')\n","assert features.member_id.is_unique and not features.duplicated(['member_id','decision_time']).any()\n","assert features.snapshot_available_at.le(features.decision_time).all()\n","\n","\n","# Use only complete historical outcomes for supervised model development.\n","complete = features.loc[features.label_status.eq('complete')].copy()\n","\n","\n","# Keep January training and February validation roles consistent with02.\n","train = complete.loc[complete.campaign_id.eq('pilot_train')].copy()\n","validation = complete.loc[complete.campaign_id.eq('pilot_validation')].copy()\n","\n","\n","# Reserve test by cohort ID; do not inspect its feature associations or outcomes here.\n","assert train.label_ready_at.max() < validation.decision_time.min()\n","assert complete.payments_complete_through.ge(complete.label_ready_at).all()\n","assert complete.label_ready_at.le(pd.Timestamp(manifest['extracted_at'])).all()\n","assert features.loc[features.label_status.ne('complete'), 'label'].isna().all()\n","assert set(train.member_id).isdisjoint(validation.member_id)\n","for forbidden in ['label','member_id','campaign_id','sent_at','delivered_at','delivery_status','completed_at','booking_status']:\n","    assert forbidden not in FEATURE_COLUMNS\n","print('[RESULT] Training / validation members and buyers:', len(train), int(train.label.sum()), len(validation), int(validation.label.sum()))"],"execution_count":null,"outputs":[],"id":"03-002"},{"cell_type":"markdown","metadata":{"section":"ADV-01 — Reload the development contract and enforce chronology"},"source":["### Takeaway — ADV-01\n","\n","**Advanced experiments begin from the same saved baseline and explicit data contract, not a new hidden sample.**\n","\n","**Before moving on:** Explain how this output supports the next decision."],"id":"03-003"},{"cell_type":"markdown","metadata":{"section":"ADV-02 — Estimate importance without using test or upcoming members"},"source":["## ADV-02 — Estimate importance without using test or upcoming members\n","\n","### The question\n","Which inputs does the fitted model rely on in a training-only diagnostic sample?\n","\n","### The plan\n","- Split January into stratified 70% fitting/30% diagnostic parts.\n","- Fit a fresh GBM/preprocessing clone on the inner fitting part.\n","- Shuffle each original input on the diagnostic part and measure AP loss over 5 repeats.\n","\n","### What to look for\n","Inspect mean AP drop and permutation variation. Correlated inputs and small support can affect this model-dependent ranking."],"id":"03-004"},{"cell_type":"code","metadata":{"section":"ADV-02 — Estimate importance without using test or upcoming members"},"source":["# Internal training-only diagnostic split; stratification preserves buyer proportions.\n","inner_fit, inner_check = train_test_split(train, test_size=.30, stratify=train.label, random_state=SEED)\n","assert set(inner_fit.member_id).isdisjoint(inner_check.member_id)\n","\n","\n","# Clone and fit a fresh GBM on inner training, including its own preprocessing.\n","importance_model = clone(basic['models']['gbm'])\n","importance_model.fit(inner_fit[FEATURE_COLUMNS], inner_fit.label.astype(int))\n","\n","\n","# Shuffle original inputs on inner diagnostic members; measure AP drop across repeats.\n","importance = permutation_importance(importance_model, inner_check[FEATURE_COLUMNS], inner_check.label.astype(int),\n","                                    scoring='average_precision', n_repeats=5, random_state=SEED)\n","\n","\n","# Report mean importance and repeat variability with deterministic feature-name ties.\n","importance_table = pd.DataFrame({'feature': FEATURE_COLUMNS, 'mean_ap_drop': importance.importances_mean,\n","                                 'permutation_std': importance.importances_std}).sort_values(['mean_ap_drop','feature'], ascending=[False,True])\n","display(importance_table)\n","importance_table.to_csv(MODEL_DIR / 'training_feature_importance.csv', index=False)\n","fig, ax = plt.subplots(figsize=(10,6))\n","importance_table.iloc[:10].sort_values('mean_ap_drop').plot.barh(x='feature', y='mean_ap_drop', ax=ax, legend=False)\n","ax.set(title='Training-only diagnostic permutation importance', xlabel='Average-precision drop; not a causal effect')\n","fig.tight_layout(); fig.savefig(MODEL_DIR / 'training_feature_importance.png', dpi=150); plt.show(); plt.close(fig)"],"execution_count":null,"outputs":[],"id":"03-005"},{"cell_type":"markdown","metadata":{"section":"ADV-02 — Estimate importance without using test or upcoming members"},"source":["### Takeaway — ADV-02\n","\n","**Importance proposes a reduced candidate; it does not prove causality or final usefulness.** February will compare the representation.\n","\n","**Before moving on:** Explain how this output supports the next decision."],"id":"03-006"},{"cell_type":"markdown","metadata":{"section":"ADV-03 — Predeclare three representations, not an open-ended search"},"source":["## ADV-03 — Predeclare three representations, not an open-ended search\n","\n","### The question\n","Should we use fewer inputs or a different representation of the same activity?\n","\n","### The plan\n","- Keep the full 18-input baseline.\n","- Define a reduced 8-input candidate from training importance.\n","- Add log1p visits and recent7-day share as fixed engineered inputs.\n","- Record the formulas and representation lists.\n","\n","### What to look for\n","Compare18/8/20 inputs. Zero recent share with no visits must be read with the original visit total."],"id":"03-007"},{"cell_type":"code","metadata":{"section":"ADV-03 — Predeclare three representations, not an open-ended search"},"source":["# Fix an eight-input candidate before February comparison; this is not an optimal-size guarantee.\n","REDUCED_COUNT = 8\n","reduced_columns = importance_table.head(REDUCED_COUNT).feature.tolist()\n","\n","\n","# Fixed feature engineering: compress visit counts and summarize recent timing.\n","features['log_checkins_30d'] = np.log1p(features.checkins_30d)\n","features['visit_share_7d'] = np.divide(features.checkins_7d, features.checkins_30d,\n","                                     out=np.zeros(len(features)), where=features.checkins_30d.to_numpy()>0)\n","assert features.visit_share_7d.between(0,1).all()\n","\n","\n","# Keep January training and February validation roles consistent with02.\n","train = features.loc[train.index].copy(); validation = features.loc[validation.index].copy()\n","\n","\n","# Define full/reduced/engineered candidates using the same available measurements.\n","representations = {'full': FEATURE_COLUMNS, 'reduced': reduced_columns,\n","                   'engineered': FEATURE_COLUMNS + ['log_checkins_30d','visit_share_7d']}\n","\n","\n","# Save exact input lists and formulas for repeatable comparison/scoring.\n","representation_contract = {'representations': representations, 'importance_population': 'January training internal diagnostic only',\n","                           'inner_fit_members': len(inner_fit), 'inner_check_members': len(inner_check),\n","                           'selection_count_fixed_before_validation': REDUCED_COUNT,\n","                           'engineering': {'log_checkins_30d':'log1p(checkins_30d)',\n","                                           'visit_share_7d':'checkins_7d/checkins_30d; zero if denominator zero'},\n","                           'test_status': 'separate_later_evaluation'}\n","(MODEL_DIR / 'representation_contract.json').write_text(json.dumps(representation_contract,indent=2))\n","display(pd.DataFrame([{'representation':name,'inputs':len(cols),'columns':', '.join(cols)} for name,cols in representations.items()]))"],"execution_count":null,"outputs":[],"id":"03-008"},{"cell_type":"markdown","metadata":{"section":"ADV-03 — Predeclare three representations, not an open-ended search"},"source":["### Takeaway — ADV-03\n","\n","**The three prespecified representations use decision-time information.** Fixed arithmetic on upcoming rows does not fit a transformation or learn from their outcomes.\n","\n","**Before moving on:** Explain how this output supports the next decision."],"id":"03-009"},{"cell_type":"markdown","metadata":{"section":"ADV-04 — Compare six fixed candidates and freeze the full pipeline"},"source":["## ADV-04 — Compare six fixed candidates and freeze the full pipeline\n","\n","### The question\n","Which model/representation should be carried to April?\n","\n","### The plan\n","- Reuse the full-feature baselines.\n","- Fit reduced/engineered Logistic and GBM on January only.\n","- Compare all 6 candidates on February at the same promotion fraction.\n","- Select Precision→AP→fewer inputs→Logistic, then save the complete choice.\n","\n","### What to look for\n","Read the same denominators across candidates and the selection record before April is evaluated."],"id":"03-010"},{"cell_type":"code","metadata":{"section":"ADV-04 — Compare six fixed candidates and freeze the full pipeline"},"source":["# Apply one promotion-budget metric recipe consistently to rule/model alternatives.\n","def ranking_summary(frame, scores=None):\n","    \"\"\"Same population and promotion fraction; descriptive purchase metrics only.\"\"\"\n","\n","    # Use the business promotion fraction and round down to a concrete list size.\n","    selected_count = int(np.floor(len(frame) * CONTACT_FRACTION))\n","\n","    # Choose staff-rule ordering or purchase-probability ordering with stable ties.\n","    if scores is None:\n","        ranked = frame.sort_values(['inquiry_60d', 'signup_at', 'member_id'], ascending=[False, True, True])\n","    else:\n","        ranked = frame.assign(score=scores).sort_values(['score', 'member_id'], ascending=[False, True])\n","\n","    # Read buyer counts with the same selected-list denominator.\n","    selected_buyers = int(ranked.head(selected_count).label.sum())\n","    buyers = int(frame.label.sum())\n","    precision = selected_buyers / selected_count\n","    rate = float(frame.label.mean())\n","    return {'members': len(frame), 'buyers': buyers, 'selected': selected_count,\n","            'selected_buyers': selected_buyers, 'precision_at_capacity': precision,\n","            'recall_at_fraction': selected_buyers / buyers if buyers else np.nan,\n","            'ranking_lift_at_fraction': precision / rate if rate else np.nan,\n","            'average_precision': float(average_precision_score(frame.label, scores)) if scores is not None else np.nan,\n","            'brier_score': float(brier_score_loss(frame.label, scores)) if scores is not None else np.nan}\n","\n","\n","# Fit each representation/model combination; retain its columns and fitted pipeline.\n","advanced_candidates = {}\n","\n","\n","# Route selected numerical and categorical inputs through training-fitted transforms.\n","for representation, columns in representations.items():\n","    numeric = [c for c in columns if c not in CATEGORICAL_FEATURES]\n","    categorical = [c for c in columns if c in CATEGORICAL_FEATURES]\n","    transformers = []\n","\n","    # Numerical handling: median/indicator imputation and scaling from training.\n","    if numeric:\n","        transformers.append(('numeric', Pipeline([('impute',SimpleImputer(strategy='median',add_indicator=True)),('scale',StandardScaler())]),numeric))\n","\n","    # Categorical handling: unknown fill and training one-hot vocabulary.\n","    if categorical:\n","        transformers.append(('categorical', Pipeline([('impute',SimpleImputer(strategy='constant',fill_value='unknown')),\n","                             ('encode',OneHotEncoder(handle_unknown='ignore',sparse_output=False))]),categorical))\n","\n","    # Use both model types for each representation, with fixed settings.\n","    for method in ['logistic_regression','gbm']:\n","        key = representation + '__' + method\n","\n","        # Reuse full-feature baselines; fit fresh clones for changed inputs.\n","        if representation == 'full':\n","            pipeline = basic['models'][method]\n","        else:\n","            estimator = clone(basic['models'][method].named_steps['model'])\n","            pipeline = Pipeline([('features',ColumnTransformer(transformers)),('model',estimator)])\n","            pipeline.fit(train[columns],train.label.astype(int))\n","        advanced_candidates[key] = {'pipeline':pipeline,'columns':columns,'numeric':numeric,'categorical':categorical}\n","\n","\n","# Compare all candidates on the same February population without fitting on it.\n","validation_rows = [{'method':'staff_rule',**ranking_summary(validation)}]\n","\n","\n","# Purchase probabilities rank the validation members; class1 is new purchase.\n","for key,candidate in advanced_candidates.items():\n","    scores = candidate['pipeline'].predict_proba(validation[candidate['columns']])[:,1]\n","    validation_rows.append({'method':key,'inputs':len(candidate['columns']),**ranking_summary(validation,scores)})\n","\n","\n","# Save every candidate result, not just the eventual selected row.\n","validation_comparison = pd.DataFrame(validation_rows).set_index('method')\n","display(validation_comparison)\n","validation_comparison.to_csv(MODEL_DIR / 'validation_comparison.csv')\n","\n","\n","# Prespecified selection: Precision, AP, fewer inputs, then Logistic.\n","selected_candidate = max(advanced_candidates,key=lambda key:(\n","    validation_comparison.loc[key,'precision_at_capacity'], validation_comparison.loc[key,'average_precision'],\n","    -len(advanced_candidates[key]['columns']), key.endswith('__logistic_regression')))\n","frozen = advanced_candidates[selected_candidate]; frozen_model = frozen['pipeline']\n","\n","\n","# Freeze the columns, pipeline and decision context before April evaluation.\n","selection_record = {'candidate':selected_candidate,'feature_columns':frozen['columns'],\n","                    'selection':'validation precision, AP, fewer inputs, Logistic; deterministic insertion order on remaining ties',\n","                    'test_used_to_select_in_this_run':False,\n","                    'test_status':'separate_later_evaluation','metrics_prespecified':True,'data_version':manifest['data_versi